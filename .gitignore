# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
kaggle.json

# private datasets and generated ML artifacts
/data/raw/
/data/processed/
/data/models/

# Python and local runtime artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.db
/backend/storage/
/backend/.postgres/

# Row-level research exports stay local; aggregate tables and figures can be shared.
/reports/ml_analysis/graph_data/*_split_assignments.csv
/reports/ml_analysis/graph_data/*_heldout_scores.csv
/reports/ml_analysis/shap_analysis/*_values.csv
/reports/ml_analysis/shap_analysis/*_examples.csv
/reports/ml_analysis/new_experiments/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
