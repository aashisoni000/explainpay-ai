# Copy to .env. Set a real password before starting Docker Compose.
POSTGRES_USER=explainpay
POSTGRES_PASSWORD=
POSTGRES_DB=explainpay
POSTGRES_PORT=5433
DATABASE_URL=
# Docker example: postgresql+psycopg://explainpay:<URL-encoded-password>@localhost:5433/explainpay
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MODEL_DIR=data/models
STORAGE_DIR=backend/storage
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=5000
VIRUSTOTAL_API_KEY=
GOOGLE_WEBRISK_API_KEY=
# RDAP is optional; lexical ML analysis never fetches a submitted website.
RDAP_ENABLED=false
